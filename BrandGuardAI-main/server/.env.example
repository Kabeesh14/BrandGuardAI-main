# BrandGuard AI Server Configuration

# Express API Port
PORT=3001

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple)
# Development: http://localhost:5173
# Production: https://your-brandguard-domain.com
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use
GEMINI_MODEL=gemini-3.5-flash

# Authentication & Authorization Configuration
# Secret for signing/verifying server session tokens
AUTH_SECRET=your_strong_random_jwt_secret_here

# Firebase Authentication (Production Identity Provider)
# Set your Firebase Project ID to enable Firebase Admin ID Token verification
FIREBASE_PROJECT_ID=
# Optional: Service Account credentials for Firebase Admin
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=brandguard_db

# MySQL SSL Configuration (for remote cloud databases such as AWS RDS, PlanetScale, Cloud SQL)
# Development (localhost): false
# Production: true
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
# Optional: Path to custom CA certificate file or raw CA string
# MYSQL_SSL_CA_PATH=/path/to/ca-certificate.pem
# MYSQL_SSL_CA=


